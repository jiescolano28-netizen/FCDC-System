APP_NAME="FCDC Synthetic Demo"
APP_ENV=demo
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
APP_CONFIG_CACHE=bootstrap/cache/config.demo.php

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
BCRYPT_ROUNDS=12

DB_CONNECTION=demo
DEMO_ENABLED=true
DEMO_ALLOWED_ENVIRONMENTS=demo,testing
DEMO_DB_DRIVER=sqlite
DEMO_DB_DATABASE="C:/absolute/path/to/fcdc-system/storage/app/demo/fcdc-demo.sqlite"
ACTIVITY_LOGGER_DB_CONNECTION=demo

SESSION_DRIVER=file
SESSION_COOKIE=fcdc_demo_session
CACHE_STORE=file
QUEUE_CONNECTION=sync
DB_QUEUE_CONNECTION=demo
DB_QUEUE_FAILED_CONNECTION=demo
DB_QUEUE_BATCHING_CONNECTION=demo
MAIL_MAILER=log
FILESYSTEM_DISK=local
